# ---------------------------------------------------------------------------
# Vulpine corporate site - environment configuration
# Copy to .env.local for development. Set the same values in Vercel for prod.
# ---------------------------------------------------------------------------

# Canonical site URL. Used for metadata, sitemap, and canonical tags.
NEXT_PUBLIC_SITE_URL=https://vulpine.llc

# --- WHERE FORM SUBMISSIONS GO (at least one is REQUIRED) ------------------
# Forms return a 503 and show an error if neither option below is configured.
# The site never reports a false success.

# Option A: email delivery via Resend (https://resend.com)
RESEND_API_KEY=
SUBMISSION_FROM_EMAIL=
SUBMISSION_TO_EMAIL=

# Option B: webhook delivery (CRM, n8n, Zapier, GoHighLevel, etc.)
SUBMISSION_WEBHOOK_URL=
SUBMISSION_WEBHOOK_SECRET=

# --- FILE UPLOADS (optional) ------------------------------------------------
# Uploads use Vercel Blob with direct client-to-storage transfer, which
# bypasses the ~4.5 MB serverless request body limit. Without a token, the
# file field is disabled and clearly labeled - it does not silently fail.
# Create the store in Vercel: Storage > Blob. The token is injected
# automatically on Vercel; set it manually for local development.
BLOB_READ_WRITE_TOKEN=

# Must be "true" to show the file upload field.
NEXT_PUBLIC_UPLOADS_ENABLED=false
